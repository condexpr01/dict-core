#!/bin/sh

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


ranwu="$1"
p86wb="$2"

cmd="$3"

if [ ! -f "$ranwu" ] && [ ! -f "$p86wb" ];then
	echo "Usage: $0 <ranwu-rime> <p86wb-rime> <behavior>"
	exit 1
fi

if [[ "$cmd" == "diff" ]];then
	echo "#p86wb缺词: "
	"$SCRIPT_DIR"/word-set-difference <("$SCRIPT_DIR"/rime-to-fmt "$ranwu") <("$SCRIPT_DIR"/rime-to-fmt "$p86wb")

	echo "#ranwu缺词: "
	"$SCRIPT_DIR"/word-set-difference <("$SCRIPT_DIR"/rime-to-fmt "$p86wb") <("$SCRIPT_DIR"/rime-to-fmt "$ranwu")

elif [[ "$cmd" == "repo" ]];then
	"$SCRIPT_DIR"/rime-to-full-fmt "$p86wb" > "${SCRIPT_DIR}"/../update-wbfmt 2>>"${SCRIPT_DIR}"/../freq-missing
	"$SCRIPT_DIR"/rime-to-full-fmt "$ranwu" > "${SCRIPT_DIR}"/../update-rwfmt 2>>"${SCRIPT_DIR}"/../freq-missing

	mkdir -p "${SCRIPT_DIR}"/../sougou
	"$SCRIPT_DIR"/fmt-to-rime "${SCRIPT_DIR}"/../update-wbfmt > "${SCRIPT_DIR}"/../sougou/wb-scheme.txt
	"$SCRIPT_DIR"/fmt-to-rime "${SCRIPT_DIR}"/../update-rwfmt > "${SCRIPT_DIR}"/../sougou/rw-scheme.txt
	"$SCRIPT_DIR"/fmt-to-sougou "${SCRIPT_DIR}"/../update-wbfmt > "${SCRIPT_DIR}"/../sougou/wb-sougou.txt
	"$SCRIPT_DIR"/fmt-to-sougou "${SCRIPT_DIR}"/../update-rwfmt > "${SCRIPT_DIR}"/../sougou/rw-sougou.txt

	"$SCRIPT_DIR"/gen-readme-ranwu "${SCRIPT_DIR}"/../update-rwfmt > "${SCRIPT_DIR}"/../readme-rw.md
	"$SCRIPT_DIR"/gen-readme-wubi "${SCRIPT_DIR}"/../update-wbfmt > "${SCRIPT_DIR}"/../readme-wb.md

fi


